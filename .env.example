#Isi semua yabg dibutuhkan di sini agar seluruh fungsi berjalan normal
GROQ_API_KEY=gsk_xxx
PAIRING_NUMBER=628xxx #Nomor bot (Kosongkan jika ingin input manual lewat terminal)
OWNER_NUMBERS=628xxx #Nomor owner (yang akan diberi akses penuh untuk kontrol bot)

BOT_PREFIX=. #prefix bebas
SESSION_DIR=session #biarkan
YTDLP_COOKIES=./cookies.txt #root cookies yt. Biarkan/ubah sesuai posisi file cookies nya
MAX_MEDIA_MINUTES=15 #maximum durasi yang dapat di download
MAX_MEDIA_MB=45 #Ukuran/Size file maximum
# MONGODB_URI= #Biarin aja
# YTDLP_PATH= #Biarin aja
# RICH_MARKDOWN=false #Biarin aja

CF_ACCOUNT_ID= #Id akun cloudflare
CF_API_TOKEN= #Api token cloudflare (Workers AI)
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b #Model bisa ganti bebas, asal fungsinya (Text to image)
AI_HISTORY=10
CF_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct #Model bisa diganti bebas, asal fungsinya (text to text)
CF_CHAT_FALLBACK=true #hanya pengaman jika groq tokenmu overlimit
